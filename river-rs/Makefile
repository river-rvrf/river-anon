# river-rs -- the performance implementation.
#
# The root Makefile discovers this directory because it matches `river-*`
# and holds a Makefile, so the standard targets below are what joins it to
# `make test` / `make kat` / `make clean` at the top level.  Everything
# here is a thin wrapper over cargo.

CARGO ?= cargo
PYTHON ?= python3

#: The cross-language KAT.  Committed, because it is the interface to
#: `../river-py` and regenerating it is a deliberate act -- see `kat-regen`.
KAT = tests/sampler_kat.json

.PHONY: all test test-debug test-all selftest kat kat-regen vectors check-vectors \
        check-vectors-status manifest manifest-regen manifest-check \
        lanes-manifest lanes-manifest-regen \
        fmt clippy bench bench-lanes bench-sizes clean distclean

all: test

## every test: unit, integration, the cross-language KAT, and the
## byte-for-byte interop against ../river-py/vectors.json
test: manifest-check test-debug
	$(CARGO) test --release

## The unit tests with overflow checks on.
##
## Not redundant with the release pass: Rust checks integer overflow only
## in debug, so a `params::check()` that wraps instead of reporting -- the
## exact defect `check_never_panics_on_arithmetic_a_caller_can_provoke`
## exists to catch -- is invisible to `--release`.  20 s against 0.5 s,
## which is the price of that test meaning what it says.
test-debug:
	$(CARGO) test --lib

## as `test`; no slow-profile sweep exists yet, so they are the same
test-all: test

## the per-module unit tests only -- the analogue of river-py's `selftest`
selftest:
	$(CARGO) test --release --lib

## the cross-language known-answer tests only; the fastest useful check
kat:
	$(CARGO) test --release --test sampler_kat

## REGENERATE the KAT from ../river-py.  Deliberate: it moves the target
## this implementation is checked against, so a diff here after anything
## other than a reference change is worth investigating.
kat-regen:
	@echo "This replaces the cross-language reference KAT."
	$(PYTHON) scripts/gen_kat.py --out $(KAT)

## `vectors.json` belongs to river-py -- it is the reference, and this is
## the implementation checked against it.  Nothing to regenerate here.
vectors:
	@echo "river-rs: vectors.json is generated by river-py; nothing to do."
	@echo "          to move the primitive KAT instead, use 'make kat-regen'."

## Byte-for-byte interop against river-py/vectors.json.
##
## Checks all four shipped cases: both profiles under
## `opening` and under `lanes-experimental`.  The reference *withholds* its
## two production `lanes` cases and this crate's gate matches, so the
## accounting is *enforced* rather than narrated: `every_case_is_checked`
## fails both if a case names a backend this crate does not have and if the
## gate lifts without the cases coming back.  Coverage cannot shrink in
## silence in either direction.
check-vectors:
	$(CARGO) test --release --test vectors -- --nocapture --test-threads=1
	@echo "river-rs: check-vectors PASSED (4 of 4 shipped cases; 2 production lanes cases withheld)"

## The same, without the exit status -- for a caller that wants the state
## of the tree rather than a gate.
check-vectors-status:
	@$(CARGO) test --release --test vectors >/dev/null 2>&1 \
	  && echo "river-rs: 4 of 4 shipped vector cases check (2 production lanes withheld)" \
	  || echo "river-rs: check-vectors FAILING"

## Print the frozen wire manifest this crate was generated against.
manifest:
	@sed -n '/^pub const N8/,/^};/p' src/manifest.rs

## REGENERATE src/manifest.rs from ../river-py/manifest.json.
##
## Deliberate, like `kat-regen`: it moves the frozen table production reads
## its Gaussian rationals, Rice parameters and bounds from, so a diff here
## after anything other than a reference change is worth investigating.
manifest-regen:
	@echo "This replaces the generated wire manifest."
	$(PYTHON) scripts/gen_manifest.py

## Regenerate into a buffer and require an empty diff.
##
## An ordinary `cargo build` needs no Python; this is the gate that keeps
## the checked-in table from drifting away from the reference it was copied
## from.  `src/manifest.rs::tests` is the other half: it re-derives every
## entry from `src/params.rs`, so the table cannot drift from this crate
## either.
manifest-check:
	$(PYTHON) scripts/gen_manifest.py --check
	$(PYTHON) scripts/gen_lanes_manifest.py --check

## Print the frozen LANES parameter manifest.
lanes-manifest:
	@sed -n '/^pub static LANES_MANIFEST/,/^};/p' src/lanes_manifest.rs

## REGENERATE src/lanes_manifest.rs from ../river-py/lanes_manifest.json.
##
## Deliberate, like `manifest-regen`.  It moves the table the LANES gate is
## decided against — and it is the *same* table `river-py` is gated on,
## which is what keeps the two implementations reporting the same cause
## rather than each its own opinion of one.
lanes-manifest-regen:
	@echo "This replaces the generated LANES parameter manifest."
	$(PYTHON) scripts/gen_lanes_manifest.py

fmt:
	$(CARGO) fmt

clippy:
	$(CARGO) clippy --all-targets -- -D warnings

bench:
	$(CARGO) run --release --bin river-bench

## Focused run for parameter and implementation work: the LANES
## ring, the exact backend, the real encoders, and current wire-size accounting.
bench-lanes:
	$(CARGO) run --release --bin river-bench -- --lanes

## Produce one deterministic LANES proof at every published profile and
## report actual framed bytes beside the paper's entropy/serializer model.
bench-sizes:
	$(CARGO) run --release --bin river-bench -- --sizes

## Remove build artifacts.  `Cargo.lock` and the KAT are deliverables and
## are preserved; keep this set in step with the repository .gitignore.
clean:
	$(CARGO) clean 2>/dev/null || rm -rf target
	@# `scripts/gen_kat.py` is Python, so a run leaves a __pycache__ that
	@# `cargo clean` knows nothing about.  It is gitignored, which made it
	@# invisible rather than absent -- and this target's contract is to
	@# remove what this component creates.
	rm -rf scripts/__pycache__
	$(RM) *~ *.swp *.swo *.tmp
	@echo "river-rs: clean (Cargo.lock and $(KAT) preserved)"

## Nothing further to remove; present so the recursive target exists.
distclean: clean
